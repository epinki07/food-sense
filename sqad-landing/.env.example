# Contact form
SQAD_CONTACT_PROVIDER=formsubmit
SQAD_CONTACT_PROVIDER_FALLBACK=
SQAD_CONTACT_TO=you@example.com
SQAD_CONTACT_FROM=you@example.com
SQAD_CONTACT_SUBJECT_PREFIX="[Food Sense]"
SQAD_CONTACT_CAPTCHA=0
SQAD_CONTACT_FORMSUBMIT_BASE=https://formsubmit.co/ajax

# MailerSend, only when SQAD_CONTACT_PROVIDER=mailersend
SQAD_CONTACT_MAILERSEND_BASE=https://api.mailersend.com/v1
SQAD_CONTACT_MAILERSEND_TOKEN=
SQAD_CONTACT_MAILERSEND_FROM=
SQAD_CONTACT_MAILERSEND_FROM_NAME=Food Sense
SQAD_CONTACT_MAILERSEND_TO=

# SMTP, only when SQAD_CONTACT_PROVIDER=smtp
SQAD_CONTACT_SMTP_HOST=
SQAD_CONTACT_SMTP_PORT=587
SQAD_CONTACT_SMTP_SECURE=0
SQAD_CONTACT_SMTP_REQUIRE_TLS=1
SQAD_CONTACT_SMTP_USER=
SQAD_CONTACT_SMTP_PASS=
SQAD_CONTACT_SMTP_FROM=
SQAD_CONTACT_SMTP_TO=

# ESP32 history database
SQAD_ESP32_DB_HOST=localhost
SQAD_ESP32_DB_PORT=3307
SQAD_ESP32_DB_USER=esp32
SQAD_ESP32_DB_PASSWORD=change-me
SQAD_ESP32_DB_NAME=sistema_refrigeradores
SQAD_ESP32_DB_TABLE=mediciones
